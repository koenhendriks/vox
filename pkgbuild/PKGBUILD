# Vox, built from this working tree, uncommitted changes included, so bin/install puts what you're working on in
# the app launcher.
#
#   bin/install                 # or: cd pkgbuild && makepkg -fsi
#
# The AUR package is generated from this file by tools/aur-pkgbuild.sh at release time: it swaps the source for the
# release tarball, pins the version and checksum and drops pkgver(). Keep build steps in terms of $_src.

pkgname=vox
pkgver=0.3.2
pkgrel=1
pkgdesc='Make your microphone sound better in every app, with switchable voice profiles'
arch=('x86_64' 'aarch64')
url='https://github.com/koenhendriks/vox'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg' 'qt6-wayland' 'pipewire' 'pipewire-pulse' 'libpulse'
         'swh-plugins' 'noise-suppression-for-voice')
makedepends=('gcc' 'make' 'git')
_src="$(realpath "$startdir/..")"
source=()
sha256sums=()

# Releases are tagged vX.Y.Z; commits after a tag become X.Y.Z.r3.gabc1234, which sorts between releases. Before the
# first tag: the version in vox.pro, then .r0 and the commit.
pkgver() {
	cd "$_src"
	local described
	if described=$(git describe --long --tags --match 'v*' 2>/dev/null); then
		echo "$described" | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
	else
		printf "%s.r0.g%s" "$(sed -n 's/^VERSION = //p' vox.pro)" "$(git rev-parse --short=7 HEAD)"
	fi
}

build() {
	cd "$_src"
	./bin/build
}

check() {
	cd "$_src"
	./bin/test
}

package() {
	cd "$_src"
	install -Dm755 build/vox "$pkgdir/usr/bin/vox"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 pkgbuild/vox.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vox.svg"
	install -Dm644 pkgbuild/vox.desktop "$pkgdir/usr/share/applications/vox.desktop"
	install -Dm644 pkgbuild/vox.service "$pkgdir/usr/lib/systemd/user/vox.service"
	install -Dm644 pkgbuild/vox-tray.desktop "$pkgdir/etc/xdg/autostart/vox-tray.desktop"
}
