pkgname=vox
pkgver=0.2.0
pkgrel=1
pkgdesc='Make your microphone sound better in every app, with switchable voice profiles'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'pipewire' 'pipewire-pulse' 'libpulse'
         'swh-plugins' 'noise-suppression-for-voice')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/vox "$pkgdir/usr/bin/vox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/vox.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/vox.svg"
  install -Dm644 "$startdir/vox.desktop" "$pkgdir/usr/share/applications/vox.desktop"
  install -Dm644 "$startdir/vox.service" "$pkgdir/usr/lib/systemd/user/vox.service"
}
